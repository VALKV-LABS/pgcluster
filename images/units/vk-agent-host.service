[Unit]
Description=vk-agent host
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vk-agent host /etc/vk-agent/host.toml
Restart=always
RestartSec=2
# Instances have units of their own, and must outlive this agent.
KillMode=process

[Install]
WantedBy=multi-user.target
