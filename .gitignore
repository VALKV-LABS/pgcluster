spec.md
BUILD*.md
AGENT_CONTEXT.md

# Sled database files (Raft log storage)
*.sled/
raft-log/

# Config files with secrets
*.local.toml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker build cache
.dockerignore
